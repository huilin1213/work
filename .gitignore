# Python
__pycache__/
*.pyc
.venv/
venv/

# Xero 自动开票工具的本地凭证/敏感数据,任何情况下都不应提交
tools/xero-dhl-invoice/.env
tools/xero-dhl-invoice/.xero_tokens.json

# 真实的 DHL 发票 PDF 含客户姓名/地址等 PII,默认不进版本库
tools/xero-dhl-invoice/samples/
*.pdf

# VAT 对账工具:真实发票登记表/银行流水含金额、供应商、账户等财务信息,不应提交
