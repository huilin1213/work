# 复制这个文件为 .env,填好之后再运行脚本(.env 已在 .gitignore 里,不会被提交)

# 你用哪个 eBay 站点买东西,填域名后半段就行(不要带 https://www.)
# 常见:ebay.co.uk / ebay.com / ebay.de / ebay.com.au ...
EBAY_DOMAIN=ebay.co.uk

# 同步出来的 Excel 文件存哪(相对路径就是相对这个文件夹),默认存在当前目录
EXCEL_PATH=./ebay_purchases.xlsx

# ebay_login.py 登录后保存 cookies 的位置,main.py / watch_sync.py 会读这个文件
# 里的登录状态去抓购买历史,不用每次重新登录
STORAGE_STATE_PATH=./storage_state.json

# watch_sync.py 常驻监听时,每隔多少分钟自动同步一次。eBay 没有"新订单"推送,
# 只能定时轮询;不建议调太短(几分钟级别),意义不大还容易被 eBay 判定成异常
# 访问,几小时一次足够用来做记账
SYNC_INTERVAL_MINUTES=360

# true = 无头模式(不弹浏览器窗口,适合常驻后台跑);排查抓取问题时可以临时改成
# false,能看到浏览器实际打开了哪些页面
HEADLESS=true
