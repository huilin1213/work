# 复制这个文件为 .env,填好之后再运行脚本(.env 已在 .gitignore 里,不会被提交)

# Xero Developer App 的 Client ID
# 申请步骤见 README.md「Xero App 申请」章节
XERO_CLIENT_ID=

# 建议直接用这个默认值;在 Xero App 后台的 Redirect URIs 里也要加上同样的地址
XERO_REDIRECT_URI=http://localhost:8765/callback

# ↓↓↓ 下面这些是每次开票时套用的默认值,按你自己 Xero 账套里的实际设置填 ↓↓↓

# Chart of Accounts 里,出口销售挂哪个科目代码
# 网页版路径: Accounting > Advanced > Chart of Accounts
XERO_ACCOUNT_CODE=200

# Settings > Invoice settings > Tax rates 里列出的 Tax Type 名字
# 出口到英国以外通常是零税率,具体名字以你账套里配置的为准,比如 ZERORATED / NONE
XERO_TAX_TYPE=ZERORATED

# 生成的发票初始状态。先用 DRAFT,人工在 Xero 里核对无误后再手动发送/过账。
# 等流程跑顺了、完全信任解析结果之后,可以考虑改成 AUTHORISED 直接过账。
XERO_INVOICE_STATUS=DRAFT
