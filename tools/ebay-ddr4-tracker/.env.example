# 复制这个文件为 .env 并填好(.env 已在 .gitignore 里,不会被提交)

# eBay Developer Program → Application Keys → Production 那一组
# 申请步骤见 README.md「申请 eBay API Key」
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# 站点和币种:英国站 EBAY_GB / GBP;美国站 EBAY_US / USD;德国站 EBAY_DE / EUR
EBAY_MARKETPLACE=EBAY_GB
EBAY_CURRENCY=GBP

# 搜索关键词。标题里必须含 DDR4 或 PC4-xxxx 才会计入。
# 只想看服务器内存可以改成:DDR4 ECC
SEARCH_QUERY=DDR4

# 类目 ID:170083 = Computers/Tablets & Networking > Computer Components & Parts > Memory (RAM)
# 留空表示不限类目(会搜到很多无关商品,不建议)
EBAY_CATEGORY_ID=170083

# 只追踪指定卖家(用 eBay 用户名,逗号分隔);留空 = 统计所有卖家
# 例:SELLERS=server-and-networking-store,another-seller
SELLERS=

# 价格范围(单位同 EBAY_CURRENCY),过滤掉 £0.99 的配件/占位商品
PRICE_MIN=1
PRICE_MAX=5000

# 每次运行最多调用多少次 API。Browse API 默认每天 5,000 次。
EBAY_MAX_CALLS=4500
