# 复制这个文件为 .env,填好之后再运行(.env 已在 .gitignore 里,不会被提交)

# ===== eBay Developer 账号 =====
# developer.ebay.com -> Application Keys -> Production 那一栏的 App ID 和 Cert ID
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# production 或 sandbox(sandbox 里几乎没有真实商品,测试完就用 production)
EBAY_ENV=production
# 站点:EBAY_US / EBAY_GB / EBAY_DE / EBAY_AU ...
EBAY_MARKETPLACE=EBAY_GB

# ===== 搜什么 =====
# 多个搜索词用 ; 分隔。eBay 搜索语法:空格 = 并且;(a,b,c) = 任意一个
# 注意:eBay 不支持两组括号 (a,b) (c,d) 同时用,实测会让结果大幅变少
# 每条可以用「搜索词 @ 类目ID」指定类目(eBay 一次搜索只能带一个类目,想盯多个类目就写多条)
#   11210  = Server Memory (RAM) 服务器内存
#   170083 = Memory (RAM) 普通内存 —— 有些卖家把服务器内存放错在这里,竞争更少。
#            这里台式机内存很多,所以第二条去掉了单独的 ECC(会命中 "Non-ECC")
# 新加/修改搜索词后,程序会先静默建立该搜索词的基线,不会把已有的老链接全推给你
# 可选第三段「@ 秒」:这条搜索词单独的快速轮询间隔(不写 = FAST_POLL_SECONDS)。
# 后两条抓「标题只写 PC4-xxxx、不写 DDR4」的 listing,数量少,每 5 分钟查一次就够,省额度
EBAY_QUERIES=DDR4 (server,ECC,RDIMM,LRDIMM,registered,REG) @ 11210;DDR4 (server,RDIMM,LRDIMM,registered,REG) @ 170083;PC4 (server,ECC,RDIMM,LRDIMM,registered,REG) @ 11210 @ 300;PC4 (server,RDIMM,LRDIMM,registered,REG) @ 170083 @ 300
# 没写 @ 的搜索词用这个类目,留空 = 不限。运行 python3 find_category.py 查类目 ID
EBAY_CATEGORY_IDS=
# 可选:价格区间(当地货币,英国站 = 英镑),留空 = 不限。设上限能明显减少全量扫描的页数
MIN_PRICE=
MAX_PRICE=
# 只看一口价(补货只对一口价有意义)。想连拍卖也看就改成 FIXED_PRICE|AUCTION
BUYING_OPTIONS=FIXED_PRICE
# 可选:额外的 Browse API filter。itemLocationCountry:GB = 只看英国境内发货,留空 = 含海外卖家
EXTRA_FILTER=itemLocationCountry:GB
# 标题里含这些词的不推送(逗号分隔,不区分大小写)
EXCLUDE_KEYWORDS=sodimm,so-dimm,laptop,notebook,macbook,non-ecc,non ecc,nonecc,udimm,unbuffered,motherboard
# 不想看的卖家(eBay 用户名,逗号分隔)。eBay 直接不返回他们的商品,结果变少、全量扫描更省调用。
# 用户名就是卖家页面上 "Seller:" 后面那个;python3 monitor.py --once 的结果里也会显示卖家用户名
EXCLUDE_SELLERS=

# ===== 频率 / 配额 =====
# 每天最多调用多少次 API。默认配额 5000/天,留点余量。通过 Growth Check 提额后改大
EBAY_DAILY_CALL_BUDGET=4500
# 多少秒查一次最新上架(每个搜索词 1 次调用:2 条搜索词 × 每 60 秒 = 2880 次/天)
FAST_POLL_SECONDS=60
# 多少分钟完整扫一遍所有结果(补漏 + 发现老链接重新上架 + 降价)。170083 类目结果多(每次约 50 页),默认额度下建议 60
SWEEP_MINUTES=60
# 多数量链接多少分钟复查一次库存(单件链接是这个的 4 倍)
WATCH_RECHECK_MINUTES=30
# 已知链接降价超过这个百分比就推送,0 = 不推送降价
PRICE_DROP_ALERT_PCT=5
# 每天几点推送一条汇总(本机时间 HH:MM),告诉你今天推送了多少、程序是否正常。留空 = 不发
# Mac 在这个时间点睡着的话,当天醒来后会补发
DAILY_SUMMARY_TIME=21:00

# ===== 推送(可以同时填多个,都不填就只在终端/日志里打印) =====
# ntfy:手机装 ntfy App,订阅一个别人猜不到的 topic 名字,例如 ram-xxxx-8f3k2
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# Telegram:找 @BotFather 建 bot 拿 token;chat_id 可以给 @userinfobot 发消息拿到
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Pushover:唯一能在 iPhone 静音模式下也响铃的通道(App 一次性付费约 $5,30 天免费试用)
# pushover.net 登录后,首页右上角的 Your User Key 填 PUSHOVER_USER_KEY;
# 页面底部 Create an Application/API Token 建一个应用,拿到的 API Token 填 PUSHOVER_APP_TOKEN
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=
# 新上架/补货/降价用的优先级:
#   2 = 紧急:静音模式也响,每隔 PUSHOVER_RETRY 秒重复响,直到你点「确认」(推荐)
#   1 = 高:不突破静音模式,只突破 Pushover 自己的免打扰时段
PUSHOVER_URGENT_PRIORITY=2
# 紧急推送:每隔多少秒重复响一次(最少 30),最多持续多少秒(最多 10800 = 3 小时)
PUSHOVER_RETRY=60
PUSHOVER_EXPIRE=600
# 提示音,留空用 App 默认;可选值见 https://pushover.net/api#sounds ,例如 persistent / siren / echo
PUSHOVER_SOUND=
# 夜间时段(按这台 Mac 的本地时间,可以跨午夜,如 23:00-07:00;留空 = 不启用):
# 这段时间内新上架/补货/降价照常推送,但改用 PUSHOVER_NIGHT_PRIORITY,
#   -1 = 静默送达,不响不震(默认);0 = 普通提醒,手机静音/勿扰时不响
PUSHOVER_NIGHT=00:00-08:00
PUSHOVER_NIGHT_PRIORITY=-1
