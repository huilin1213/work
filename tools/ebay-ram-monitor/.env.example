# 复制这个文件为 .env,填好之后再运行(.env 已在 .gitignore 里,不会被提交)

# ===== eBay Developer 账号 =====
# developer.ebay.com -> Application Keys -> Production 那一栏的 App ID 和 Cert ID
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# production 或 sandbox(sandbox 里几乎没有真实商品,测试完就用 production)
EBAY_ENV=production
# 站点:EBAY_US / EBAY_GB / EBAY_DE / EBAY_AU ...
EBAY_MARKETPLACE=EBAY_GB

# ===== 搜什么 =====
# 多个搜索词用 ; 分隔。eBay 搜索语法:空格 = 并且;(a,b,c) = 任意一个
# 默认这一条 = 标题含 DDR4,并且含 server/ECC/RDIMM/LRDIMM/registered/REG 任意一个
EBAY_QUERIES=DDR4 (server,ECC,RDIMM,LRDIMM,registered,REG)
# 可选:限定类目(多个用逗号)。运行 python3 find_category.py 查服务器内存的类目 ID
EBAY_CATEGORY_IDS=
# 可选:价格区间(当地货币,英国站 = 英镑),留空 = 不限。设上限能明显减少全量扫描的页数
MIN_PRICE=
MAX_PRICE=
# 只看一口价(补货只对一口价有意义)。想连拍卖也看就改成 FIXED_PRICE|AUCTION
BUYING_OPTIONS=FIXED_PRICE
# 可选:额外的 Browse API filter。itemLocationCountry:GB = 只看英国境内发货,留空 = 含海外卖家
EXTRA_FILTER=itemLocationCountry:GB
# 标题里含这些词的不推送(逗号分隔,不区分大小写)
EXCLUDE_KEYWORDS=sodimm,so-dimm,laptop,notebook,macbook,non-ecc,non ecc,nonecc,udimm,unbuffered,motherboard

# ===== 频率 / 配额 =====
# 每天最多调用多少次 API。默认配额 5000/天,留点余量。通过 Growth Check 提额后改大
EBAY_DAILY_CALL_BUDGET=4500
# 多少秒查一次最新上架(每个搜索词 1 次调用)
FAST_POLL_SECONDS=60
# 多少分钟完整扫一遍所有结果(补漏 + 发现老链接重新上架)
SWEEP_MINUTES=60
# 多数量链接多少分钟复查一次库存(单件链接是这个的 4 倍)
WATCH_RECHECK_MINUTES=30
# 已知链接降价超过这个百分比就推送,0 = 不推送降价
PRICE_DROP_ALERT_PCT=5

# ===== 推送(两个都可以填,都不填就只在终端/日志里打印) =====
# ntfy:手机装 ntfy App,订阅一个别人猜不到的 topic 名字,例如 ram-xxxx-8f3k2
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# Telegram:找 @BotFather 建 bot 拿 token;chat_id 可以给 @userinfobot 发消息拿到
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
